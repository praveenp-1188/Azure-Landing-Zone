# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

management_subscription_id   = "00000000-0000-0000-0000-000000000000"
connectivity_subscription_id = "11111111-1111-1111-1111-111111111111"

# Move workload subscriptions into the hierarchy.
subscription_placement = {
  # corp    = ["22222222-2222-2222-2222-222222222222"]
  # sandbox = ["33333333-3333-3333-3333-333333333333"]
}

root_id   = "alz"
root_name = "Azure Landing Zone"

primary_location  = "westeurope"
allowed_locations = ["westeurope", "northeurope"]

required_tags         = ["environment", "owner", "cost-center"]
enforce_required_tags = false

hub_address_space = ["10.0.0.0/22"]
hub_subnet_prefixes = {
  firewall = "10.0.0.0/26"
  gateway  = "10.0.0.64/27"
  bastion  = "10.0.0.128/26"
  shared   = "10.0.1.0/24"
}

enable_firewall = false
enable_bastion  = false

tags = {
  environment = "platform"
  owner       = "platform-team"
  cost-center = "it-shared"
}
